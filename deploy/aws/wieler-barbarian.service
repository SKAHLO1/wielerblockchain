[Unit]
Description=WIELER Barbarian agent
After=network-online.target
Wants=network-online.target

[Service]
User=wieler
WorkingDirectory=/opt/wieler/scripts
EnvironmentFile=/etc/wieler/barbarian.env
ExecStart=/usr/bin/node barbarian.mjs
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
