# Copy to scripts/.env
MASTER_ACCOUNT=your-account.testnet
# Demo epoch length (ms). 10 minutes by default.
EPOCH_MS=600000
# Optional overrides
# NEAR_NODE_URL=https://test.rpc.fastnear.com
# MPC_CONTRACT=v1.signer-prod.testnet
# SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
# SOLANA_RPC=https://api.devnet.solana.com
# BTC_API=https://blockstream.info/testnet/api
# BARBARIAN_FLOOR=5000
# BARBARIAN_SEED=5000000
# Servers without a near-cli keychain: comma-separated account=secret-key pairs.
# NEAR_SIGNER_KEYS=keeper.example.testnet=ed25519:...,barbarian.example.testnet=ed25519:...
# KEEPER_ACCOUNT=keeper.example.testnet
